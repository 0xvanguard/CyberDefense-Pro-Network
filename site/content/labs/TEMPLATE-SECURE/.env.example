# 🔒 Environment Variables Template
# CyberDefense Pro Network - Docker Labs
#
# Instrucciones:
#   1. Copiar este archivo como .env
#   2. Modificar los valores según el lab
#   3. NUNCA subir .env a git (agregar a .gitignore)
#   4. Ejecutar: docker compose --env-file .env up -d

# ============================================
# Lab Configuration
# ============================================
LAB_NAME=lab

# ============================================
# Database Credentials
# ============================================
MYSQL_ROOT_PASSWORD=CHANGE_ME_strong_password_123!
MYSQL_DATABASE=lab
MYSQL_USER=labuser
MYSQL_PASSWORD=CHANGE_ME_strong_password_456!

# ============================================
# Application Credentials
# ============================================
ADMIN_PASSWORD=CHANGE_ME_admin_password_789!
API_KEY=CHANGE_ME_api_key_xyz

# ============================================
# Ports (to avoid conflicts)
# ============================================
WEB_PORT=8080
DB_PORT=3306
SSH_PORT=2222

# ============================================
# Wazuh (if applicable)
# ============================================
WAZUH_INDEXER_PASSWORD=CHANGE_ME_wazuh_password!
WAZUH_API_PASSWORD=CHANGE_ME_wazuh_api_password!

# ============================================
# DVWA (if applicable)
# ============================================
DVWA_PASSWORD=CHANGE_ME_dvwa_password!

# ============================================
# Security Settings
# ============================================
# Set to 'true' to enable verbose logging
DEBUG=false

# Set to 'true' to enable network isolation
NETWORK_ISOLATION=true
